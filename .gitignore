# Guaranteed Data Protection & Leak Prevention

# SQLite databases & journals (Local Evidence Vault)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.bak

# Case Data & Evidence Backups
backups/
exports/
*.csv
*.tsv
evidence_export_*.csv
virgoyt_evidence_*.csv

# Sensitive environment files & tokens
.env
*.env
*.key
*.pem
*.token
*credentials*
id_rsa
id_ed25519

# Python bytecode & caching
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
wheels/
